classDiagram
direction TB
class Element {
  <<interface>>
  +name() String
  +accept(Visitor) void
}
class Node {
  <<abstract, sealed>>
  -String name
  -DirectoryNode parent
  +name() String
  ~attachTo(DirectoryNode) void
}
class FileNode {
  -long size
  +size() long
  +accept(Visitor) void
}
class DirectoryNode {
  -Map children
  +add(Node) DirectoryNode
  +children() List~Node~
  +accept(Visitor) void
}
class Visitor {
  <<interface>>
  +visit(FileNode) void
  +visit(DirectoryNode) void
}
class TreeVisitor~R~ {
  <<abstract>>
  +evaluate(Element) R
  +visit(FileNode) void
  +visit(DirectoryNode) void
  #reset() void
  #onFile(FileNode, VisitContext) void
  #onDirectory(DirectoryNode, VisitContext) void
  #result() R
}
class TotalSizeVisitor {
  -long total
  #result() Long
}
class SearchVisitor {
  -Predicate filenameCriterion
  -long minimumSize
  -List matches
  #result() List~String~
}
class StatisticsVisitor {
  -long fileCount
  -long directoryCount
  -int maximumDepth
  #result() Statistics
}
class VisitContext {
  <<record>>
  +String path
  +int depth
}
class Statistics {
  <<record>>
  +long fileCount
  +long directoryCount
  +int maximumDepth
}
Element <|.. Node
Node <|-- FileNode
Node <|-- DirectoryNode
DirectoryNode "0..1" *-- "0..*" Node : owns
Element ..> Visitor : accept
Visitor <|.. TreeVisitor
TreeVisitor <|-- TotalSizeVisitor
TreeVisitor <|-- SearchVisitor
TreeVisitor <|-- StatisticsVisitor
TreeVisitor ..> Element : visits
TreeVisitor ..> VisitContext : frame
StatisticsVisitor ..> Statistics : creates
